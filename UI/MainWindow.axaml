<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UI"
        x:Class="UI.MainWindow"
        Title="Game Of Life"
        Width="1300" Height="800"
        MinWidth="500" MinHeight="400">

    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Game">
                <MenuItem x:Name="GameLoadMenuItem"  Header="Load" />
                <MenuItem x:Name="GameNewMenuItem"   Header="New"   Click="NewGameHandler" />
                <MenuItem x:Name="GameRunMenuItem"   Header="Run"   Click="RunGameHandler" />
                <MenuItem x:Name="GameStepMenuItem"  Header="Step"  Click="StepGameHandler" />
                <MenuItem x:Name="GamePauseMenuItem" Header="Pause" Click="PauseGameHandler" />
                <Separator />
                <MenuItem x:Name="GameExitMenuItem"  Header="Exit"  Click="ExitGameHandler" />
            </MenuItem>
            <MenuItem Header="Settings">
                <MenuItem Header="Visualization..." Click="VisualizationSettingsHandler" />
            </MenuItem>
        </Menu>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: game panel + generation counter -->
            <DockPanel Grid.Column="0" Margin="4,4,0,4">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Generation" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border BorderBrush="Gray" BorderThickness="1" MinWidth="100" Padding="4,2">
                        <TextBlock x:Name="lblGeneration" TextAlignment="Right" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
                <Border x:Name="gamePanelBorder" BorderBrush="Gray" BorderThickness="1">
                    <local:GamePanel x:Name="gamePanel" />
                </Border>
            </DockPanel>

            <!-- Center: collapsible controls panel -->
            <DockPanel x:Name="controlsPanel" Grid.Column="1" Width="220" Margin="8,4,2,4">

                <!-- New Game / Exit pinned to bottom -->
                <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,*" Margin="0,8,0,0">
                    <Button x:Name="btnNew"  Grid.Column="0" Content="New Game" HorizontalAlignment="Stretch" Margin="0,0,2,0" Click="NewGameHandler" />
                    <Button x:Name="btnExit" Grid.Column="1" Content="Exit"     HorizontalAlignment="Stretch" Margin="2,0,0,0" Click="ExitGameHandler" />
                </Grid>

                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,*">
                        <Button x:Name="btnRun"  Grid.Column="0" Content="Run"  HorizontalAlignment="Stretch" Margin="0,0,2,0" Click="RunGameHandler" />
                        <Button x:Name="btnStep" Grid.Column="1" Content="Step" HorizontalAlignment="Stretch" Margin="2,0,0,0" Click="StepGameHandler" />
                    </Grid>
                    <Button x:Name="btnPause" Content="Pause" HorizontalAlignment="Stretch" Click="PauseGameHandler" />

                    <HeaderedContentControl Header="Speed">
                        <Slider x:Name="SpeedSlider" />
                    </HeaderedContentControl>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Rows" />
                        <Slider x:Name="TrackRows" />
                        <NumericUpDown x:Name="UpDownRows" HorizontalAlignment="Stretch"
                                       Increment="1" FormatString="F0" />

                        <TextBlock Text="Cols" Margin="0,4,0,0" />
                        <Slider x:Name="TrackCols" />
                        <NumericUpDown x:Name="UpDownCols" HorizontalAlignment="Stretch"
                                       Increment="1" FormatString="F0" />
                    </StackPanel>

                    <CheckBox x:Name="CheckboxLockRowAndCols" Content="Match Rows and Cols" IsChecked="True" />
                </StackPanel>

            </DockPanel>

            <!-- Right: panel toggle (always visible) -->
            <Button x:Name="btnToggleControls" Grid.Column="2"
                    Content="◀" Padding="4,2"
                    VerticalAlignment="Top" Margin="0,4,4,0"
                    Click="ToggleControlsHandler" />

        </Grid>

    </DockPanel>

</Window>
